# ============================================================
# KwanzaFolha API - Variaveis de Ambiente
# ============================================================

# --- Servidor ---
PORT=3001

# --- Base de Dados (API - utilizador kwanzafolha_app) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=hr_system
DB_USER=kwanzafolha_app
DB_PASSWORD=<password do kwanzafolha_app>

# --- Base de Dados (Migrations - utilizador postgres) ---
# IMPORTANTE: as migrations precisam do superuser postgres porque fazem DDL
# (CREATE/ALTER TABLE, CREATE ROLE, GRANT, etc). O kwanzafolha_app so tem DML.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hr_system

# --- Password do role kwanzafolha_app (usada na migration 007_app_role) ---
# Deve ser a MESMA que a DB_PASSWORD acima. Esta variavel e lida pela migration
# que cria o role, nunca hardcoded no codigo.
APP_DB_PASSWORD=<password do kwanzafolha_app>

# --- Seeds ---
# Password do utilizador SUPER_ADMIN criado pelo seed.
# Se nao for definida, usa "admin123" (apenas para desenvolvimento!).
SEED_ADMIN_PASSWORD=<password do admin>

# --- Autenticacao ---
JWT_SECRET=um-segredo-bem-comprido-e-aleatorio